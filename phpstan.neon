includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Used only by Livewire single-file pages (resources/views/pages), which are not analysed.
        -
            identifier: trait.unused
            path: app/Livewire/Concerns/RecordsContactAttempts.php
